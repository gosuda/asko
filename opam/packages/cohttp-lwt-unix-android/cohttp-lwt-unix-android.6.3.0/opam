depends: [
  # These tools run in Dune's native context.
  "ppx_sexp_conv" {build & >= "v0.13.0"}
  "dune" {>= "3.8"}
  "ocaml-android" {>= "4.08"}
  "http-android" {= version}
  "cohttp-android" {= version}
  "cohttp-lwt-android" {= version}
  "lwt-android" {>= "3.0.0"}
  "conduit-lwt-android" {>= "7.1.0"}
  "conduit-lwt-unix-android" {>= "7.1.0"}
  "fmt-android" {>= "0.8.2"}
  "ppx_sexp_conv-android" {>= "v0.13.0"}
