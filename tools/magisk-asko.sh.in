#!/system/bin/sh
# Magisk late_start. Only the launcher is root; the backend uses the Termux UID.
asko_uid=@UID@
(
  set -eu
  unset LD_PRELOAD LD_LIBRARY_PATH
  case "$asko_uid" in ''|*[!0-9]*) exit 1;; esac
  [ "$asko_uid" -ge 10000 ] || exit 1
  # Stay in the background until first unlock makes credential-encrypted storage
  # available, including when the device remains locked overnight.
  until [ -x /data/data/com.termux/files/home/asko/current/asko ] &&
        [ -x /data/data/com.termux/files/home/asko/supervise-phone.sh ]; do
    /system/bin/sleep 5
  done
  [ "$(/system/bin/stat -c %u /data/data/com.termux)" = "$asko_uid" ] || exit 1
  asko_su=$(command -v su 2>/dev/null || true)
  if [ -z "$asko_su" ] || [ ! -x "$asko_su" ]; then
    asko_su=
    for asko_candidate in /system/bin/su /system/xbin/su /sbin/su /debug_ramdisk/su /su/bin/su /product/bin/su; do
      if [ -x "$asko_candidate" ]; then asko_su=$asko_candidate; break; fi
    done
  fi
  [ -n "$asko_su" ] || exit 1
  exec "$asko_su" -d -g "$asko_uid" -G 3003 -s /system/bin/sh "$asko_uid" \
    -c /data/data/com.termux/files/home/asko/supervise-phone.sh
) >/dev/null 2>&1 </dev/null &
